# Copy to scripts/config.env and edit. scripts/lib.sh loads it.
# Values marked "as of 2026-11" change often: re-verify before running.

# --- AWS and cluster ---------------------------------------------------------------
export AWS_REGION="us-west-2"
export CLUSTER_NAME="gpu-sandbox"
# EKS standard support for 1.36 ends on 2027-08-02. HyperPod supports EKS 1.36.
export K8S_VERSION="1.36"
# What scripts/02_create_cluster.sh (CDK) builds: A, B1, B2 or C (see the script header). The Kata
# node groups are added to any scenario with WITH_KATA_CPU=1 and WITH_KATA_GPU=1 (scripts/kata/).
export SCENARIO="A"
export WITH_KATA_CPU="0"
export WITH_KATA_GPU="0"
# The EKS API endpoint is private; reach it with cdk/tunnel.sh. Only if you accept a public endpoint
# (some account security checks flag it), set your workstation's single IPv4 address as /32:
# export EKS_PUBLIC_ACCESS_CIDR="203.0.113.10/32"
# IAM role or user ARNs (comma-separated) that get cluster admin. Empty: cdk/deploy.sh uses your
# current role.
export ADMIN_PRINCIPAL_ARN=""

# --- Images (built and pushed by scripts/03_build_push_images.sh) ------------------
export ECR_REPO_PREFIX="gpu-sandbox"
export IMAGE_TAG="v1"

# --- Node groups (scenario A: everything on EC2) -----------------------------------
export SYSTEM_INSTANCE_TYPE="m6i.large"
# g5 runs the proprietary NVIDIA driver with GSP off, verified with gVisor nvproxy on 2026-11-18.
# g6 (open driver, documented by gVisor) can be set instead (also HYPERPOD_*).
export TRAINER_INSTANCE_TYPE="g5.2xlarge"     # 1x A10G 24GB, 8 vCPU, 32 GiB
export GVISOR_INSTANCE_TYPE="g5.xlarge"       # 1x A10G per sandbox pod
export GVISOR_NODES="2"
export KATA_CPU_INSTANCE_TYPE="c8i.2xlarge"   # nested virtualization, no GPU (scenario C, CPU tier)
export KATA_GPU_INSTANCE_TYPE="g4dn.metal"    # 8x T4, the only x86 NVIDIA bare-metal type

# --- Pinned runtime versions (as of 2026-11) ----------------------------------------
export GVISOR_RELEASE="20261109.0"
export KATA_VERSION="4.3.1"
export NVIDIA_DEVICE_PLUGIN_VERSION="0.20.1"
export GPU_OPERATOR_VERSION="v26.7.2"

# --- Sandbox API authentication ------------------------------------------------------
export SANDBOX_AUDIENCE="gpu-sandbox"

# --- Scenario B (HyperPod) -----------------------------------------------------------
export HYPERPOD_CLUSTER_NAME="gpu-sandbox-hp"
export HYPERPOD_TRAINER_INSTANCE_TYPE="ml.g5.2xlarge"
# Bucket for lifecycle scripts. HyperPod's managed policy expects the "sagemaker-" prefix.
export HYPERPOD_LCS_BUCKET="sagemaker-gpu-sandbox-lcs-__SET_ME__"

# --- Scenario B2 (gVisor sandboxes on a HyperPod instance group) ----------------------
# The HyperPod EKS AMI ships NVIDIA 595.91.07, which gVisor nvproxy does not know (as of
# 2026-11). scripts/hyperpod/build_b2_ami.sh bakes a custom AMI with this driver instead.
export B2_NVIDIA_DRIVER_VERSION="580.178.04"
# sha256 of NVIDIA-Linux-x86_64-580.178.04.run, used only if the base AMI installed the driver
# with the .run installer. Matches NVIDIA's .sha256sum and gVisor's nvproxy ABI table.
export B2_NVIDIA_RUNFILE_SHA256="5975a86ee45bffcb626f51ae33d1169b108186a2ea47ad651e72f13fa4b6d6f9"
export HYPERPOD_SANDBOX_INSTANCE_TYPE="ml.g5.xlarge"   # 1x A10G per sandbox pod
export HYPERPOD_SANDBOX_COUNT="2"
# Printed by scripts/hyperpod/build_b2_ami.sh.
export HYPERPOD_B2_AMI_ID=""
