# Kata + Cloud Hypervisor, CPU only, on a nested-virtualization node (c8i). Supported upstream.
# Used to rehearse Kata cheaply and as the CPU tier in production.
export RUNTIME="kata-clh-cpu"
export RUNTIME_CLASS="kata-clh"
export NODE_ROLE="sandbox-kata"
export NODE_SELECTOR='{"gpusandbox/role": "sandbox-kata", "gpusandbox/kata-gpu": "false"}'
export ACCELERATOR_LIMIT='# CPU-only profile'
export CPU="1"
export MEMORY="2Gi"
export SANDBOX_DEVICE="cpu"
export SANDBOX_SIZE="smoke"
export REPLICAS="${KATA_CPU_REPLICAS:-2}"
