# gVisor (runsc, no nvproxy), CPU only, on the nested-virtualization node (c8i). Lets one node
# compare all three runtimes under the same conditions (scenario C).
export RUNTIME="gvisor-cpu"
export RUNTIME_CLASS="gvisor-cpu"
export NODE_ROLE="sandbox-kata"
export NODE_SELECTOR='{"gpusandbox/role": "sandbox-kata", "gpusandbox/kata-gpu": "false"}'
export ACCELERATOR_LIMIT='# CPU-only profile'
export CPU="1"
export MEMORY="2Gi"
export SANDBOX_DEVICE="cpu"
export SANDBOX_SIZE="smoke"
export REPLICAS="${KATA_CPU_REPLICAS:-2}"
