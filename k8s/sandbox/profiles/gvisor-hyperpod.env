# gVisor + nvproxy on the HyperPod sandbox instance group (scenario B2): ml.g5.xlarge (1x A10G)
# from a custom AMI whose NVIDIA driver nvproxy supports. One sandbox pod per node.
export RUNTIME="gvisor-hyperpod"
export RUNTIME_CLASS="gvisor-hyperpod"
export NODE_ROLE="sandbox-hyperpod"
export NODE_SELECTOR='{"gpusandbox/role": "sandbox-hyperpod"}'
export ACCELERATOR_LIMIT='nvidia.com/gpu: "1"'
export CPU="3"
export MEMORY="12Gi"
export SANDBOX_DEVICE="cuda"
export SANDBOX_SIZE="full"
# One replica per version, so that v1 and v2 each fit on one of the two sandbox nodes during a
# rollout (scripts/ops/rollout.sh).
export REPLICAS="${GVISOR_HYPERPOD_REPLICAS:-1}"
