# Kata + QEMU with NVIDIA GPU passthrough on g4dn.metal (8x T4). Supported upstream.
# Go shim VM size = default_memory (8 GiB) + limits; RuntimeClass overhead adds 10 GiB / 1 CPU.
# 8 pods x (16 GiB + 10 GiB) = 208 GiB of the node's 384 GiB, and VFIO pins all guest memory.
export RUNTIME="kata-qemu"
export RUNTIME_CLASS="kata-qemu-nvidia-gpu"
export NODE_ROLE="sandbox-kata"
export NODE_SELECTOR='{"gpusandbox/role": "sandbox-kata", "gpusandbox/kata-gpu": "true"}'
export ACCELERATOR_LIMIT='nvidia.com/pgpu: "1"'
export CPU="8"
export MEMORY="16Gi"
export SANDBOX_DEVICE="cuda"
export SANDBOX_SIZE="full"
export REPLICAS="${KATA_QEMU_REPLICAS:-4}"
