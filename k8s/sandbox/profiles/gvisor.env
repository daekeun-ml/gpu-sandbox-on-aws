# gVisor + nvproxy on g5.xlarge (1x A10G). One sandbox pod per node.
export RUNTIME="gvisor"
export RUNTIME_CLASS="gvisor"
export NODE_ROLE="sandbox-gvisor"
export NODE_SELECTOR='{"gpusandbox/role": "sandbox-gvisor"}'
export ACCELERATOR_LIMIT='nvidia.com/gpu: "1"'
export CPU="3"
export MEMORY="12Gi"
export SANDBOX_DEVICE="cuda"
export SANDBOX_SIZE="full"
export REPLICAS="${GVISOR_NODES:-2}"
