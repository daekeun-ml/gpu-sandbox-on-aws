# EXPERIMENTAL: Kata + Cloud Hypervisor with GPU passthrough. Not supported upstream; requires
# infra/kata/experimental-clh-gpu/values-clh-gpu.yaml. Shares the g4dn.metal node with kata-qemu.
export RUNTIME="kata-clh"
export RUNTIME_CLASS="kata-clh-nvidia-gpu"
export NODE_ROLE="sandbox-kata"
export NODE_SELECTOR='{"gpusandbox/role": "sandbox-kata", "gpusandbox/kata-gpu": "true"}'
export ACCELERATOR_LIMIT='nvidia.com/pgpu: "1"'
export CPU="8"
export MEMORY="16Gi"
export SANDBOX_DEVICE="cuda"
export SANDBOX_SIZE="full"
export REPLICAS="${KATA_CLH_REPLICAS:-2}"
