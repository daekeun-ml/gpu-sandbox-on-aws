# Sandbox version v2, shipped mid-training: more correctness seeds and a plausibility cap on
# speedups (KernelBench flags anything above 10x). In a real rollout v2 would also be a new
# image tag (security patches, a new Triton); here the change is in the harness settings.
export VERSION="v2"
export HARNESS_SEEDS="5"
export HARNESS_MAX_SPEEDUP="10"
export SANDBOX_MAX_EVALS="200"     # recycle each pod (a fresh VM under Kata) every 200 evaluations
